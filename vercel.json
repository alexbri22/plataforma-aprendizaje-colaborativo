{
  "buildCommand": "npm run migrate:deploy --workspace apps/api && npm run build --workspace apps/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "apps/api/src/vercel.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/apps/api/src/vercel" },
    { "source": "/health", "destination": "/apps/api/src/vercel" },
    { "source": "/((?!api|health).*)", "destination": "/index.html" }
  ]
}
