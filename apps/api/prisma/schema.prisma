// Transcripción del modelo relacional y del diccionario de datos de
// docs/diseno-desarrollo-general.md §4.4/§5.1 (cuentas) y de la entidad de
// sesión descrita en docs/diseno-desarrollo-nucleo.md §3.2. El modelo
// documentado es la fuente normativa; este archivo es su transcripción
// (docs/diseno-desarrollo-general.md §2.2).
//
// Toda modificación de este esquema debe ir acompañada, en el mismo pull
// request, de la actualización de las secciones 4.4 y 5 del documento
// general (docs/diseno-desarrollo-general.md §2.4).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum NivelEstudios {
  primaria
  secundaria
  preparatoria_o_bachillerato
  licenciatura
  posgrado
  otro

  @@map("nivel_estudios")
}

enum TipoCuenta {
  usuario
  administrador

  @@map("tipo_cuenta")
}

enum EstadoCuenta {
  activa
  desactivada

  @@map("estado_cuenta")
}

// docs/diseno-desarrollo-general.md §6.1: seis fases del ciclo de vida. Este
// incremento ("Actividades I", docs/diseno-desarrollo-nucleo.md §11.2) solo
// produce actividades en fase inscripcion (ver nota de creación más abajo),
// pero el enum conserva el ciclo completo.
enum EstadoActividad {
  configuracion
  inscripcion
  formacion_equipos
  desarrollo
  cierre
  archivada

  @@map("estado_actividad")
}

enum RolMembresia {
  organizador
  co_organizador
  participante

  @@map("rol_membresia")
}

enum EstadoMembresia {
  activa
  desactivada

  @@map("estado_membresia")
}

// docs/diseno-desarrollo-general.md §6.2: catálogo fijo de las ocho
// funciones de seguimiento (el reporte de trabajo dejó de ser una función:
// es el elemento `avances` de espacio_equipo, con su calendario en
// PeriodoReporte). El valor de estado de cada una vive en
// ConfiguracionFuncion.estado como texto (ver la nota de ese modelo): este
// enum solo fija cuáles funciones existen, no sus estados posibles.
enum FuncionSeguimiento {
  formacion_equipos
  bitacora_individual
  calificacion
  autoevaluacion_individual
  autoevaluacion_grupal
  evaluacion_pares
  espacio_equipo
  insignias

  @@map("funcion_seguimiento")
}

// Un periodo cancelado conserva su orden y puede reactivarse (nucleo §9.2).
enum EstadoPeriodo {
  activo
  cancelado

  @@map("estado_periodo")
}

// docs/diseno-desarrollo-general.md §7.3: permisos otorgables a una
// membresía de co-organizador. Los ocho primeros forman el conjunto por
// defecto al agregar un co-organizador; gestionar_coorganizadores e
// iniciar_cierre_y_archivar no.
enum PermisoCoorganizador {
  configurar_actividad
  gestionar_inscripcion
  gestionar_equipos
  calificar_y_comentar
  leer_bitacoras
  otorgar_insignias
  desactivar_participantes
  consultar_historial_completo
  gestionar_coorganizadores
  iniciar_cierre_y_archivar

  @@map("permiso_coorganizador")
}

// docs/diseno-desarrollo-general.md §4.4 y §8.2: quién disparó un evento.
// 'sistema' es el actor de las transiciones automáticas por vencimiento de
// fecha (nucleo §7.5).
enum TipoActorHistorial {
  usuario
  sistema

  @@map("tipo_actor_historial")
}

// docs/diseno-desarrollo-general.md §8.1: la categoría, no el tipo, decide
// quién puede ver el evento.
enum CategoriaEvento {
  aportacion
  estructura
  evaluacion

  @@map("categoria_evento")
}

// docs/diseno-desarrollo-general.md §5.1
model Usuario {
  idUsuario            String        @id @default(uuid()) @map("id_usuario")
  nombre               String
  apellidoPaterno      String        @map("apellido_paterno")
  apellidoMaterno      String        @map("apellido_materno")
  nivelEstudios        NivelEstudios @map("nivel_estudios")
  institucionEducativa String        @map("institucion_educativa")
  // Único sin distinguir mayúsculas (docs/diseno-desarrollo-nucleo.md §2.5 y
  // §6.2): citext en lugar de un índice funcional sobre lower(correo).
  correo               String        @unique @db.Citext
  // Si otras personas ven el correo en el perfil básico. Privado por defecto
  // (docs/diseno-desarrollo-nucleo.md §6.3); el administrador lo ve siempre.
  correoPublico        Boolean       @default(false) @map("correo_publico")
  contrasena           String
  tipoCuenta           TipoCuenta    @default(usuario) @map("tipo_cuenta")
  estadoCuenta         EstadoCuenta  @default(activa) @map("estado_cuenta")
  fechaRegistro        DateTime      @default(now()) @map("fecha_registro")

  sesiones         Sesion[]
  membresias       Membresia[]
  eventosHistorial Historial[]
  foto             FotoDePerfil?
  solicitudNombre  SolicitudCambioNombre?

  recursosFormativos RecursoFormativo[]
  cursos             Curso[]
  inscripcionesCurso InscripcionCurso[]
  recursosGuardados  RecursoGuardado[]
  rutasFormativas    RutaFormativa[]
  preferencias       PreferenciasFormativas?

  @@map("usuarios")
}

// Foto de perfil (docs/diseno-desarrollo-nucleo.md §6.3). Va en su propia
// tabla y no como columna de usuarios porque el contenido pesa decenas de KB
// y usuarios se lee en cada petición para resolver la sesión: una columna
// bytea ahí viajaría con cada `findUnique` salvo que todos se acordaran de
// omitirla. Se guarda en la base y no en disco porque el API corre como
// función sin sistema de archivos persistente (vercel.json); la foto llega
// ya reducida por el cliente (256 px), así que el tamaño es acotado.
model FotoDePerfil {
  idUsuario     String   @id @map("id_usuario")
  contenido     Bytes
  tipo          String
  actualizadaEn DateTime @default(now()) @map("actualizada_en")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@map("fotos_de_perfil")
}

// Solicitud de cambio de nombre (docs/diseno-desarrollo-nucleo.md §6.3). Una
// cuenta de usuario no cambia su nombre directamente: lo pide y un
// administrador lo aprueba. Una sola por persona (idUsuario único): enviar otra
// reemplaza a la anterior, así que la fila es siempre la vigente. Aprobarla
// aplica el nombre; aprobada o rechazada (con su motivo), la fila se conserva
// para avisarle a la persona hasta que la descarte o envíe otra.
model SolicitudCambioNombre {
  idSolicitud     String                @id @default(uuid()) @map("id_solicitud")
  idUsuario       String                @unique @map("id_usuario")
  nombre          String
  apellidoPaterno String                @map("apellido_paterno")
  apellidoMaterno String                @map("apellido_materno")
  estado          EstadoSolicitudNombre @default(pendiente)
  motivoRechazo   String?               @map("motivo_rechazo")
  creadaEn        DateTime              @default(now()) @map("creada_en")
  resueltaEn      DateTime?             @map("resuelta_en")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([estado, creadaEn])
  @@map("solicitudes_cambio_nombre")
}

enum EstadoSolicitudNombre {
  pendiente
  aprobada
  rechazada

  @@map("estado_solicitud_nombre")
}

// Sesión de servidor (docs/diseno-desarrollo-nucleo.md §3.2): la cookie solo
// guarda este identificador, nunca el estado de la sesión.
model Sesion {
  id              String   @id @map("id_sesion")
  idUsuario       String   @map("id_usuario")
  usuario         Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  creadaEn        DateTime @default(now()) @map("creada_en")
  ultimaActividad DateTime @default(now()) @map("ultima_actividad")
  expiraEn        DateTime @map("expira_en")

  @@index([idUsuario])
  @@map("sesiones")
}

// docs/diseno-desarrollo-general.md §5.1. clave_ingreso nula hasta abrirse la
// inscripción según ese diccionario; por decisión de producto vigente para
// este incremento (docs/diseno-desarrollo-nucleo.md §7.1-§7.2, y ver la nota
// en services/actividades/actividades.service.ts) la clave se genera desde
// la creación, así que aquí nunca es nula en la práctica aunque la columna
// lo permita.
model Actividad {
  idActividad            String          @id @default(uuid()) @map("id_actividad")
  nombre                 String
  objetivo               String
  informacionGeneral     String          @map("informacion_general")
  fechaInicio            DateTime        @map("fecha_inicio")
  fechaTermino           DateTime        @map("fecha_termino")
  fechaLimiteInscripcion DateTime        @map("fecha_limite_inscripcion")
  plazoCierreDias        Int             @map("plazo_cierre_dias")
  numeroEquiposEsperado  Int             @map("numero_equipos_esperado")
  // Ajuste de la función formacion_equipos (nucleo §8.8, P-27): tamaño que
  // puede tener un equipo. Nulo = sin límite. Ninguno es restricción de esquema:
  // los aplica la capa de servicios de Equipos.
  tamanoMinimoEquipo     Int?            @map("tamano_minimo_equipo")
  tamanoMaximoEquipo     Int?            @map("tamano_maximo_equipo")
  estado                 EstadoActividad @default(inscripcion)
  claveIngreso           String?         @unique @map("clave_ingreso")
  fechaCreacion          DateTime        @default(now()) @map("fecha_creacion")

  membresias       Membresia[]
  configuracion    ConfiguracionFuncion[]
  periodos         PeriodoReporte[]
  equipos          Equipo[]
  eventosHistorial Historial[]

  @@map("actividades")
}

// docs/diseno-desarrollo-general.md §5.1 y §4.2 ("El organizador como
// membresía"): no hay columna de propietario en Actividad, el organizador es
// la membresía con rol organizador.
model Membresia {
  idMembresia String          @id @default(uuid()) @map("id_membresia")
  idActividad String          @map("id_actividad")
  idUsuario   String          @map("id_usuario")
  rol         RolMembresia
  estado      EstadoMembresia @default(activa)
  fechaUnion  DateTime        @default(now()) @map("fecha_union")

  actividad Actividad                       @relation(fields: [idActividad], references: [idActividad], onDelete: Cascade)
  usuario   Usuario                         @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  permisos  PermisoCoorganizadorMembresia[]

  insigniasOtorgadas InsigniaOtorgada[]      @relation("otorgante")
  insigniasRecibidas InsigniaOtorgada[]      @relation("receptor")
  integranteEquipo   IntegranteEquipo?
  elementosDeEquipo  ElementoEspacioEquipo[]
  entradasBitacora   Bitacora[]
  comentarios        Comentario[]

  @@unique([idActividad, idUsuario])
  @@map("membresias")
}

// docs/diseno-desarrollo-general.md §4.4: "Solo las membresías con rol de
// co-organizador tienen filas" (regla de integridad de §4.6, no expresable
// como restricción de esquema; se verifica en la capa de servicios).
model PermisoCoorganizadorMembresia {
  idMembresia String               @map("id_membresia")
  permiso     PermisoCoorganizador

  membresia Membresia @relation(fields: [idMembresia], references: [idMembresia], onDelete: Cascade)

  @@id([idMembresia, permiso])
  @@map("permisos_coorganizador")
}

// docs/diseno-desarrollo-general.md §6.2 y §4.2 ("Configuración de
// funciones como filas"): una fila por función del catálogo. `estado` es
// texto y no un enum común porque el espacio de valores válidos difiere
// por función (dos valores en bitácora, tres en formación de equipos); para
// espacio_equipo, que agrupa metas/avances/recursos, es un JSON serializado
// con los tres sub-estados. La validación de qué valores son aceptables
// por función vive en la capa de servicios (mismo criterio que los
// instrumentos genéricos de nucleo §10.1), no en el esquema.
model ConfiguracionFuncion {
  idActividad String             @map("id_actividad")
  funcion     FuncionSeguimiento
  estado      String

  actividad Actividad @relation(fields: [idActividad], references: [idActividad], onDelete: Cascade)

  @@id([idActividad, funcion])
  @@map("configuracion_funciones")
}

// docs/diseno-desarrollo-general.md §4.4 y nucleo §9.2: calendario de los
// avances (reporte de trabajo) de una actividad. Periodos explícitos y no
// una periodicidad guardada: se generan a partir de una y después se
// ajustan o cancelan uno a uno. La propiedad es del módulo de Seguimiento,
// que es el único que los lee y escribe. Fechas de calendario guardadas
// como medianoche UTC, igual que las de Actividad.
model PeriodoReporte {
  idPeriodo   String        @id @default(uuid()) @map("id_periodo")
  idActividad String        @map("id_actividad")
  orden       Int
  fechaInicio DateTime      @map("fecha_inicio")
  fechaFin    DateTime      @map("fecha_fin")
  estado      EstadoPeriodo @default(activo)

  actividad Actividad @relation(fields: [idActividad], references: [idActividad], onDelete: Cascade)

  @@unique([idActividad, orden])
  @@map("periodos_reporte")
}

// docs/diseno-desarrollo-general.md §4.4 y §5.2. La propiedad es del módulo de
// Equipos, que es el único que lee y escribe estas dos tablas; las
// membresías y la actividad se consultan por la capa de servicios de
// Actividades. Las reglas que el esquema no expresa (la membresía es de la
// misma actividad que el equipo, no está desactivada al asignarla, un
// participante de una actividad en desarrollo tiene exactamente un equipo,
// §4.6) se verifican en services/equipos.
//
// `orden` es una secuencia de creación y no una columna del diccionario: la
// fecha no sirve de desempate porque los equipos de una propuesta se crean
// en una sola transacción y comparten `now()`, y el reparto equilibrado
// (nucleo §8.3) resuelve empates "por orden de creación del equipo".
// El nombre es único dentro de la actividad sin distinguir mayúsculas
// (citext, igual que el correo).
model Equipo {
  idEquipo             String   @id @default(uuid()) @map("id_equipo")
  idActividad          String   @map("id_actividad")
  nombre               String   @db.Citext
  descripcionActividad String?  @map("descripcion_actividad")
  formaDeTrabajo       String?  @map("forma_de_trabajo")
  fechaCreacion        DateTime @default(now()) @map("fecha_creacion")
  orden                Int      @default(autoincrement())

  actividad   Actividad               @relation(fields: [idActividad], references: [idActividad], onDelete: Cascade)
  integrantes IntegranteEquipo[]
  elementos   ElementoEspacioEquipo[]

  @@unique([idActividad, nombre])
  @@map("equipos")
}

// Único: id_membresia. Una membresía pertenece a un único equipo por
// actividad (general §4.4), y como la membresía ya es de una sola
// actividad, basta la unicidad sobre ella.
model IntegranteEquipo {
  idEquipo    String @map("id_equipo")
  idMembresia String @map("id_membresia")

  equipo    Equipo    @relation(fields: [idEquipo], references: [idEquipo], onDelete: Cascade)
  membresia Membresia @relation(fields: [idMembresia], references: [idMembresia], onDelete: Cascade)

  @@id([idEquipo, idMembresia])
  @@unique([idMembresia])
  @@map("integrantes_equipo")
}

// docs/diseno-desarrollo-general.md §4.4 y §5.2; docs/diseno-desarrollo-nucleo.md
// §9.1. Metas, avances y recursos comparten estructura (un texto, un autor,
// una fecha) y se modelan como una sola relación con un atributo de tipo, en
// vez de tres relaciones paralelas (registro de decisión del general §4.4).
// La propiedad es del módulo de Seguimiento; de Equipos y de las membresías
// solo conoce lo que expone la capa de servicios de Equipos (nucleo §1.2:
// Seguimiento depende de Equipos).
//
// Sin id_periodo todavía: el diseño de "avances = reporte con calendario de
// periodos" (nucleo §9.2) es Fase B. Aquí un elemento `avance` es contenido
// libre, igual que `meta` y `recurso`.
model ElementoEspacioEquipo {
  idElemento         String       @id @default(uuid()) @map("id_elemento")
  idEquipo           String       @map("id_equipo")
  tipoElemento       TipoElemento @map("tipo_elemento")
  contenido          String
  idMembresiaAutor   String       @map("id_membresia_autor")
  fechaCreacion      DateTime     @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime     @updatedAt @map("fecha_actualizacion")

  equipo Equipo    @relation(fields: [idEquipo], references: [idEquipo], onDelete: Cascade)
  autor  Membresia @relation(fields: [idMembresiaAutor], references: [idMembresia], onDelete: Cascade)

  @@index([idEquipo, tipoElemento])
  @@map("elementos_espacio_equipo")
}

// Mismos tres valores y el mismo plural que ELEMENTOS_ESPACIO_EQUIPO de
// @plataforma/shared (las claves de configuracion_funciones.estado para
// espacio_equipo): un solo vocabulario para "cuál de los tres" en
// configuración y en contenido (nucleo §2.2), aunque el diccionario de
// datos del general (§5.2) lo describa en singular.
enum TipoElemento {
  metas
  avances
  recursos

  @@map("tipo_elemento")
}

// docs/diseno-desarrollo-general.md §4.4 y §5.2; docs/diseno-desarrollo-nucleo.md
// §9.3. Vinculada a la membresía y no al equipo, de modo que acompaña a la
// persona si se la reasigna. La propiedad es del módulo de Seguimiento, que
// es el único que lee y escribe esta tabla.
model Bitacora {
  idEntrada          String   @id @default(uuid()) @map("id_entrada")
  idMembresia        String   @map("id_membresia")
  contenido          String
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  membresia Membresia @relation(fields: [idMembresia], references: [idMembresia], onDelete: Cascade)

  @@index([idMembresia])
  @@map("bitacoras")
}

enum TipoEntidadComentario {
  elemento_espacio_equipo
  bitacora

  @@map("tipo_entidad_comentario")
}

// docs/diseno-desarrollo-general.md §4.4 y §5.3; docs/diseno-desarrollo-nucleo.md
// §10.4. Un comentario apunta a un elemento concreto del espacio de equipo o
// a una entrada de bitácora, nunca a un equipo ni a una persona en
// abstracto: id_entidad es siempre un identificador presente, sin llave
// foránea porque apunta a dos tablas distintas según tipo_entidad — mismo
// patrón sin llave foránea que ya usa Historial (§4.4, "Transversales"). La
// visibilidad no es un atributo propio: la hereda la entidad referida
// (concepto §5.3).
model Comentario {
  idComentario       String                @id @default(uuid()) @map("id_comentario")
  idMembresiaAutor   String                @map("id_membresia_autor")
  tipoEntidad        TipoEntidadComentario @map("tipo_entidad")
  idEntidad          String                @map("id_entidad")
  contenido          String
  fechaCreacion      DateTime              @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime              @updatedAt @map("fecha_actualizacion")

  autor Membresia @relation(fields: [idMembresiaAutor], references: [idMembresia], onDelete: Cascade)

  @@index([tipoEntidad, idEntidad])
  @@map("comentarios")
}

// docs/diseno-desarrollo-general.md §4.4: referencia polimórfica hacia la
// entidad observada (sin llave foránea, por diseño: "el historial observa a
// todos los módulos sin que estos lo conozcan"). Este incremento solo
// escribe eventos de transición de fase; no existe todavía la envoltura
// transaccional de emisión garantizada de nucleo §2.4 ni un endpoint de
// consulta — ambos quedan para el incremento de Desbloqueo.
model Historial {
  idEvento       String             @id @default(uuid()) @map("id_evento")
  idActividad    String             @map("id_actividad")
  tipoActor      TipoActorHistorial @map("tipo_actor")
  idUsuarioActor String?            @map("id_usuario_actor")
  tipoEvento     String             @map("tipo_evento")
  tipoEntidad    String             @map("tipo_entidad")
  idEntidad      String             @map("id_entidad")
  datos          Json
  categoria      CategoriaEvento
  fecha          DateTime           @default(now())

  actividad    Actividad @relation(fields: [idActividad], references: [idActividad], onDelete: Cascade)
  usuarioActor Usuario?  @relation(fields: [idUsuarioActor], references: [idUsuario], onDelete: SetNull)

  @@index([idActividad, fecha])
  @@map("historial")
}

// docs/diseno-desarrollo-general.md §5.4. El origen determina cuánto vale el
// reconocimiento: el del organizador pesa doble. `sistema` queda declarado
// para las señales automáticas de fase 2; hoy nada lo emite.
enum FuenteOtorgamiento {
  par
  organizador
  sistema

  @@map("fuente_otorgamiento")
}

// docs/diseno-desarrollo-general.md §4.4 y §5.4 (relación
// 'insignias_otorgadas'). La categoría se guarda como texto y no como enum
// porque el catálogo vive en packages/shared (CATEGORIAS_INSIGNIA) y sus
// identificadores llevan guion ('buen-juicio'), que un enum de Prisma no
// admite; la capa de servicios valida contra ese catálogo antes de escribir.
//
// No lleva id_actividad: el receptor es una membresía y la actividad se
// deriva de ahí (§4.4, "por qué la unicidad se expresa sobre membresías").
// Que otorgante y receptor sean de la misma actividad lo garantiza el
// servicio, no el esquema (§4.6).
//
// La unicidad (categoría, otorgante, receptor) deja pasar varias filas con
// otorgante nulo porque PostgreSQL trata cada NULL como distinto, y eso es lo
// que se quiere: la regla "una insignia por categoría a la misma persona" es
// para personas; las señales de `sistema` no tienen otorgante y cada una
// aporta su fracción propia, así que pueden acumularse en la misma categoría.
model InsigniaOtorgada {
  idOtorgamiento       String             @id @default(uuid()) @map("id_otorgamiento")
  categoria            String
  idMembresiaOtorgante String?            @map("id_membresia_otorgante")
  idMembresiaReceptor  String             @map("id_membresia_receptor")
  fuente               FuenteOtorgamiento
  puntos               Float
  frase                String
  fecha                DateTime           @default(now())

  otorgante Membresia? @relation("otorgante", fields: [idMembresiaOtorgante], references: [idMembresia], onDelete: SetNull)
  receptor  Membresia  @relation("receptor", fields: [idMembresiaReceptor], references: [idMembresia], onDelete: Cascade)

  @@unique([categoria, idMembresiaOtorgante, idMembresiaReceptor])
  @@index([idMembresiaReceptor])
  @@map("insignias_otorgadas")
}

// Contenido formativo (docs/diseno-desarrollo-formacion.md §6 y §9;
// docs/diseno-desarrollo-general.md §5.5). Sin llave foránea hacia
// actividades, equipos ni evaluaciones: aislamiento deliberado (concepto §7).

enum SeccionFormativa {
  que_es_colaborar
  como_colaborar

  @@map("seccion_formativa")
}

enum TipoRecurso {
  texto
  pdf
  video
  enlace
  plantilla

  @@map("tipo_recurso")
}

// El estatus que el documento general reservaba (§4.4) se activa con tres
// valores: el administrador prepara un borrador, lo publica y puede retirarlo.
// Los estados de revisión de la autoría abierta se añadirían aquí.
enum EstatusRecurso {
  borrador
  publicado
  retirado

  @@map("estatus_recurso")
}

// `area` y `elementos` se guardan como texto, igual que la categoría de
// insignias: el catálogo vive en packages/shared (AREAS_HABILIDAD,
// ELEMENTOS_COLABORACION) y el servicio valida contra él antes de escribir.
//
// `contenido` depende del tipo: markdown para texto y plantilla, URL https
// para video y enlace, vacío para pdf (el archivo va en archivos_recurso).
// Un borrador puede estar incompleto; los mínimos de publicación (§6.4) los
// exige el servicio al pasar a publicado.
model RecursoFormativo {
  idRecurso          String           @id @default(uuid()) @map("id_recurso")
  seccion            SeccionFormativa
  titulo             String
  resumen            String           @default("")
  tipoRecurso        TipoRecurso      @map("tipo_recurso")
  contenido          String           @default("")
  transcripcion      String           @default("")
  area               String?
  elementos          String[]         @default([])
  duracionMin        Int?             @map("duracion_min")
  fuente             String           @default("")
  licencia           String           @default("")
  orden              Int              @default(0)
  estatus            EstatusRecurso   @default(borrador)
  // Título, resumen, área y elementos en minúsculas y sin acentos, para que
  // la búsqueda del catálogo encuentre "comunicacion" en "Comunicación" sin
  // depender de la extensión unaccent. Lo calcula el servicio al guardar.
  textoBusqueda      String           @default("") @map("texto_busqueda")
  // Nulo solo si la cuenta del autor desaparece: las cuentas no se eliminan
  // en el producto, pero así borrar un usuario nunca arrastra contenido
  // público.
  idUsuarioAutor     String?          @map("id_usuario_autor")
  fechaCreacion      DateTime         @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime         @updatedAt @map("fecha_actualizacion")

  autor     Usuario?          @relation(fields: [idUsuarioAutor], references: [idUsuario], onDelete: SetNull)
  archivo   ArchivoRecurso?
  lecciones LeccionCurso[]
  guardados RecursoGuardado[]

  @@index([estatus, orden])
  @@map("recursos_formativos")
}

// Archivo adjunto de un recurso (PDF). Tabla aparte por la misma razón que
// fotos_de_perfil: el contenido pesa hasta 4 MB y no debe viajar cada vez que
// se lista el catálogo.
model ArchivoRecurso {
  idRecurso     String   @id @map("id_recurso")
  contenido     Bytes
  tipo          String
  nombre        String
  tamano        Int
  actualizadoEn DateTime @default(now()) @map("actualizado_en")

  recurso RecursoFormativo @relation(fields: [idRecurso], references: [idRecurso], onDelete: Cascade)

  @@map("archivos_recurso")
}

// Cursos (docs/diseno-desarrollo-formacion.md §2.4, §5 y §9.1). Un curso es
// una secuencia ordenada de lecciones; cada lección reutiliza un recurso de la
// biblioteca o es contenido propio del curso (lectura, práctica, reflexión).
//
// Simplificaciones respecto a §9.1, mientras solo el administrador crea
// contenido: no hay VersionCurso ni RevisionContenido (el curso se edita en
// sitio, como los recursos) ni ModuloCurso (con 2-5 lecciones basta el orden).

enum NivelCurso {
  inicial
  intermedio
  avanzado

  @@map("nivel_curso")
}

enum TipoLeccion {
  recurso
  lectura
  practica
  reflexion

  @@map("tipo_leccion")
}

// `estatus` reutiliza el enum de recursos: el ciclo editorial es el mismo.
// La duración no se guarda: se calcula sumando la de sus lecciones, para que
// nunca se desfase de lo que el curso contiene. Como en recursos, un borrador
// puede estar incompleto y los mínimos se exigen al publicar (servicio).
model Curso {
  idCurso            String         @id @default(uuid()) @map("id_curso")
  titulo             String
  resumen            String         @default("")
  objetivo           String         @default("")
  area               String?
  elementos          String[]       @default([])
  nivel              NivelCurso?
  practicaFinal      String         @default("") @map("practica_final")
  orden              Int            @default(0)
  estatus            EstatusRecurso @default(borrador)
  textoBusqueda      String         @default("") @map("texto_busqueda")
  // Sube con cada guardado de la ficha. El editor manda la que leyó y el
  // servidor rechaza el guardado si cambió: así un administrador no pisa sin
  // saberlo lo que otro guardó mientras tanto. Las lecciones no la mueven,
  // porque se guardan una por una y no reescriben nada ajeno.
  versionFicha       Int            @default(0) @map("version_ficha")
  idUsuarioAutor     String?        @map("id_usuario_autor")
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion")

  autor         Usuario?           @relation(fields: [idUsuarioAutor], references: [idUsuario], onDelete: SetNull)
  lecciones     LeccionCurso[]
  inscripciones InscripcionCurso[]
  rutas         CursoRuta[]

  @@index([estatus, orden])
  @@map("cursos")
}

// `id_recurso` solo en lecciones de tipo recurso; las demás llevan su propio
// `contenido`. RESTRICT en la llave hacia el recurso: un recurso que forma
// parte de algún curso no se puede borrar (decisión de producto); el servicio
// lo comprueba antes para dar un error claro, y la base lo garantiza.
//
// La unicidad (curso, orden) obliga a reordenar en dos pasos dentro de una
// transacción (ver reordenarLecciones en cursos.service.ts).
model LeccionCurso {
  idLeccion   String      @id @default(uuid()) @map("id_leccion")
  idCurso     String      @map("id_curso")
  orden       Int
  titulo      String      @default("")
  tipo        TipoLeccion
  idRecurso   String?     @map("id_recurso")
  contenido   String      @default("")
  obligatoria Boolean     @default(true)
  duracionMin Int?        @map("duracion_min")

  curso       Curso                @relation(fields: [idCurso], references: [idCurso], onDelete: Cascade)
  recurso     RecursoFormativo?    @relation(fields: [idRecurso], references: [idRecurso], onDelete: Restrict)
  progresos   ProgresoLeccion[]
  reflexiones ReflexionFormativa[]

  @@unique([idCurso, orden])
  @@index([idRecurso])
  @@map("lecciones_curso")
}

// ---- Progreso del alumno (docs/diseno-desarrollo-formacion.md §9.1 y la
// nota del incremento 3). Todo es privado de la persona: ningún otro usuario
// ni el administrador lo consulta. Sin versiones de curso, el progreso se
// guarda por lección y el porcentaje se calcula con las lecciones actuales.

// Se crea (o se recupera) la primera vez que la persona toca el curso con
// sesión. La finalización se fija una sola vez y no se borra aunque el curso
// cambie después.
model InscripcionCurso {
  idInscripcion        String    @id @default(uuid()) @map("id_inscripcion")
  idUsuario            String    @map("id_usuario")
  idCurso              String    @map("id_curso")
  fechaInicio          DateTime  @default(now()) @map("fecha_inicio")
  fechaFinalizacion    DateTime? @map("fecha_finalizacion")
  // Para "Continúa aprendiendo": el curso que se tocó más recientemente.
  fechaUltimaActividad DateTime  @default(now()) @map("fecha_ultima_actividad")

  usuario     Usuario              @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  // RESTRICT: un curso con inscripciones no se elimina, solo se retira, para
  // no borrar el progreso de nadie.
  curso       Curso                @relation(fields: [idCurso], references: [idCurso], onDelete: Restrict)
  progresos   ProgresoLeccion[]
  reflexiones ReflexionFormativa[]

  @@unique([idUsuario, idCurso])
  @@index([idCurso])
  @@map("inscripciones_curso")
}

// Una lección completada dentro de una inscripción. Si el administrador quita
// la lección, su progreso se va con ella.
model ProgresoLeccion {
  idInscripcion   String   @map("id_inscripcion")
  idLeccion       String   @map("id_leccion")
  fechaCompletada DateTime @default(now()) @map("fecha_completada")

  inscripcion InscripcionCurso @relation(fields: [idInscripcion], references: [idInscripcion], onDelete: Cascade)
  leccion     LeccionCurso     @relation(fields: [idLeccion], references: [idLeccion], onDelete: Cascade)

  @@id([idInscripcion, idLeccion])
  @@index([idLeccion])
  @@map("progreso_leccion")
}

// Respuesta privada a una lección de reflexión. Nunca se califica ni se
// muestra a otra persona.
model ReflexionFormativa {
  idInscripcion      String   @map("id_inscripcion")
  idLeccion          String   @map("id_leccion")
  texto              String
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  inscripcion InscripcionCurso @relation(fields: [idInscripcion], references: [idInscripcion], onDelete: Cascade)
  leccion     LeccionCurso     @relation(fields: [idLeccion], references: [idLeccion], onDelete: Cascade)

  @@id([idInscripcion, idLeccion])
  @@index([idLeccion])
  @@map("reflexiones_formativas")
}

// Biblioteca personal: guardar no inicia un curso ni genera medición.
model RecursoGuardado {
  idUsuario     String   @map("id_usuario")
  idRecurso     String   @map("id_recurso")
  fechaGuardado DateTime @default(now()) @map("fecha_guardado")

  usuario Usuario          @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  recurso RecursoFormativo @relation(fields: [idRecurso], references: [idRecurso], onDelete: Cascade)

  @@id([idUsuario, idRecurso])
  @@index([idRecurso])
  @@map("recursos_guardados")
}

// ---- Rutas de aprendizaje (docs/diseno-desarrollo-formacion.md §4.1 y la
// nota del incremento 4). Una ruta es una selección editorial ordenada de 2 a
// 5 cursos con una misma finalidad. Área, elementos, nivel y duración no se
// guardan: se calculan de sus cursos, para que nunca los contradigan. El
// progreso de una ruta también se calcula, del de sus cursos.
model RutaFormativa {
  idRuta             String         @id @default(uuid()) @map("id_ruta")
  titulo             String
  // Para qué sirve la ruta: la frase que se lee en el catálogo.
  finalidad          String         @default("")
  descripcion        String         @default("")
  orden              Int            @default(0)
  estatus            EstatusRecurso @default(borrador)
  // La ruta editorial que se muestra cuando no hay con qué recomendar (sin
  // sesión o sin datos). A lo más una; marcar otra desmarca la anterior.
  destacada          Boolean        @default(false)
  textoBusqueda      String         @default("") @map("texto_busqueda")
  // Mismo control de edición simultánea que en cursos.
  versionFicha       Int            @default(0) @map("version_ficha")
  idUsuarioAutor     String?        @map("id_usuario_autor")
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion")

  autor  Usuario?    @relation(fields: [idUsuarioAutor], references: [idUsuario], onDelete: SetNull)
  cursos CursoRuta[]

  @@index([estatus, orden])
  @@map("rutas_formativas")
}

// Un curso dentro de una ruta, en su posición. Un curso puede estar en varias
// rutas, pero una sola vez en cada una.
model CursoRuta {
  idRuta  String @map("id_ruta")
  idCurso String @map("id_curso")
  orden   Int

  ruta  RutaFormativa @relation(fields: [idRuta], references: [idRuta], onDelete: Cascade)
  // RESTRICT: un curso que forma parte de una ruta no se elimina; se quita
  // de la ruta o se retira.
  curso Curso         @relation(fields: [idCurso], references: [idCurso], onDelete: Restrict)

  @@id([idRuta, idCurso])
  @@unique([idRuta, orden])
  @@index([idCurso])
  @@map("cursos_ruta")
}

// Lo que la persona dijo que quiere fortalecer: hasta dos de los cinco
// elementos de Johnson y Johnson (nota del incremento 4). Es una declaración
// propia y privada, no una medición; el recomendador de rutas la usa como
// señal de interés.
model PreferenciasFormativas {
  idUsuario          String   @id @map("id_usuario")
  elementos          String[] @default([])
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@map("preferencias_formativas")
}
