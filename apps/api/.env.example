PORT=3001

# Postgres local levantado con `docker compose up -d` desde la raíz del
# monorepo (docs/diseno-desarrollo-general.md §2.6). SHADOW_DATABASE_URL es
# la base sombra que Prisma Migrate usa para detectar deriva de esquema
# (docs/diseno-desarrollo-nucleo.md §2.5); ambas bases las crea
# scripts/postgres-init al iniciar el contenedor.
DATABASE_URL="postgresql://plataforma:plataforma@localhost:5433/plataforma"
SHADOW_DATABASE_URL="postgresql://plataforma:plataforma@localhost:5433/plataforma_shadow"

# Base separada para `npm test`: los tests limpian sus tablas entre casos,
# así que si corrieran contra DATABASE_URL borrarían cuentas reales de
# desarrollo cada vez que alguien corriera las pruebas. `npm test` la migra
# sola antes de correr (script "pretest").
DATABASE_URL_TEST="postgresql://plataforma:plataforma@localhost:5433/plataforma_test"

# Orígenes del cliente web permitidos por CORS, separados por comas
# (docs/diseno-desarrollo-nucleo.md §3.2). En Vercel no hace falta tocarlo:
# ahí la API vive en el mismo despliegue (mismo origen). Solo importa en
# local y para depuración directa contra la API.
WEB_ORIGIN="http://localhost:5173"

# Cookie de sesión (docs/diseno-desarrollo-nucleo.md §3.2). Los tiempos de
# expiración son la propuesta por defecto de P-22 (nucleo §6.7): no hay
# valor confirmado todavía.
SESSION_COOKIE_NAME="sesion"
SESSION_IDLE_TIMEOUT_HORAS=168
SESSION_ABSOLUTE_TIMEOUT_HORAS=720

# Costo de la derivación de contraseña con argon2id (docs/diseno-desarrollo-nucleo.md
# §3.2). Los valores por defecto son el mínimo recomendado por OWASP; se
# suben en producción si el hardware lo permite.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Límite de intentos en registro e inicio de sesión (docs/diseno-desarrollo-nucleo.md
# §3.2 y §3.3).
RATE_LIMIT_REGISTRO_VENTANA_MIN=15
RATE_LIMIT_REGISTRO_MAX=20
RATE_LIMIT_SESION_VENTANA_MIN=15
RATE_LIMIT_SESION_MAX=10
RATE_LIMIT_CLAVE_VENTANA_MIN=15
RATE_LIMIT_CLAVE_MAX=20
